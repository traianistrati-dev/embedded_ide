diff --git a/examples/stm32g4/src/bin/comp.rs b/examples/stm32g4/src/bin/comp.rs
new file mode 100644
index 0000000..7214187
--- /dev/null
+++ b/examples/stm32g4/src/bin/comp.rs
@@ -0,0 +1,66 @@
+// Analog comparators.
+//
+// COMP1 compares PA1 against an internal fraction of VREFINT, so it needs a
+// single pin. COMP4 compares PB0 against PB2, i.e. two external signals.
+//
+// Unlike the L4/L5 family, where every comparator shares one vector, the G4
+// spreads them out: COMP1..3 sit on `COMP1_2_3`, and COMP4 has `COMP4` to
+// itself on a part with no COMP5. Both go in the same `bind_interrupts!`.
+
+#![no_std]
+#![no_main]
+
+use defmt::*;
+use defmt_rtt as _;
+use embassy_executor::Spawner;
+use embassy_stm32::bind_interrupts;
+use embassy_stm32::comp::{self, Comp, Config, Hysteresis, InvertingInput, OutputPolarity};
+use embassy_stm32::peripherals;
+use panic_probe as _;
+
+bind_interrupts!(
+    pub struct Irqs {
+        COMP1_2_3 => comp::InterruptHandler<peripherals::COMP1>;
+        COMP4 => comp::InterruptHandler<peripherals::COMP4>;
+});
+
+#[embassy_executor::main]
+async fn main(_spawner: Spawner) {
+    let p = embassy_stm32::init(Default::default());
+    info!("Hello World!");
+
+    // COMP1: PA1 against 1/2 of VREFINT, so roughly 0.6 V on this family.
+    //
+    // Hysteresis is in millivolts here; the L4/L5 and U5 comparators name four
+    // levels instead. It keeps a slowly moving input from chattering across the
+    // threshold: without it a signal that creeps through 0.6 V produces a burst
+    // of edges instead of one.
+    //
+    // `Config::power_mode` is deliberately left alone: this driver only writes
+    // it on the comp_u5 generation, so setting it here would change nothing.
+    let mut config = Config::default();
+    config.inverting_input = InvertingInput::HalfVref;
+    config.hysteresis = Hysteresis::Hyst20M;
+    config.output_polarity = OutputPolarity::NotInverted;
+
+    let mut comp1 = Comp::new(p.COMP1, p.PA1, Irqs, config);
+    comp1.enable();
+
+    // COMP4: PB0 against PB2. The inverting input is a pin here, so
+    // `config.inverting_input` does not apply and this constructor ignores it.
+    let mut comp4 = Comp::new_with_input_minus_pin(p.COMP4, p.PB0, p.PB2, Irqs, Config::default());
+    comp4.enable();
+
+    info!(
+        "start: COMP1 is {}, COMP4 is {}",
+        comp1.output_level(),
+        comp4.output_level()
+    );
+
+    loop {
+        // Nothing runs on the CPU while this waits: the comparator drives an
+        // EXTI line, and the interrupt wakes the task.
+        comp1.wait_for_any_edge().await;
+        info!("COMP1 crossed, now {}", comp1.output_level());
+    }
+}
