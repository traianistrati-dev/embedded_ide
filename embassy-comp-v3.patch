+// Analog comparators.
+//
+// COMP1 compares PB2 against an internal fraction of VREFINT, so it needs a
+// single pin. COMP2 compares PB4 against PB7, i.e. two external signals.
+//
+// Both comparators share one interrupt (`COMP`) on this family, so both
+// handlers go in the same `bind_interrupts!`.
+
+#![no_std]
+#![no_main]
+
+use defmt::*;
+use defmt_rtt as _;
+use embassy_executor::Spawner;
+use embassy_stm32::bind_interrupts;
+use embassy_stm32::comp::{self, Comp, Config, Hysteresis, InvertingInput, OutputPolarity, PowerMode};
+use embassy_stm32::peripherals;
+use panic_probe as _;
+
+bind_interrupts!(
+    pub struct Irqs {
+        COMP => comp::InterruptHandler<peripherals::COMP1>,
+                comp::InterruptHandler<peripherals::COMP2>;
+});
+
+#[embassy_executor::main]
+async fn main(_spawner: Spawner) {
+    let p = embassy_stm32::init(Default::default());
+    info!("Hello World!");
+
+    // COMP1: PB2 against 3/4 of VREFINT, so roughly 0.9 V on this family.
+    //
+    // Hysteresis keeps a slowly moving input from chattering across the
+    // threshold; without it a signal that creeps through 0.9 V produces a burst
+    // of edges instead of one.
+    let mut config = Config::default();
+    config.inverting_input = InvertingInput::ThreeQuarterVref;
+    config.hysteresis = Hysteresis::Medium;
+    config.power_mode = PowerMode::HighSpeed;
+    config.output_polarity = OutputPolarity::NotInverted;
+
+    let mut comp1 = Comp::new(p.COMP1, p.PB2, Irqs, config);
+    comp1.enable();
+
+    // COMP2: PB4 against PB7. The inverting input is a pin here, so
+    // `config.inverting_input` does not apply and this constructor ignores it.
+    let mut comp2 = Comp::new_with_input_minus_pin(p.COMP2, p.PB4, p.PB7, Irqs, Config::default());
+    comp2.enable();
+
+    info!(
+        "start: COMP1 is {}, COMP2 is {}",
+        comp1.output_level(),
+        comp2.output_level()
+    );
+
+    loop {
+        // Nothing runs on the CPU while this waits: the comparator drives an
+        // EXTI line, and the interrupt wakes the task.
+        comp1.wait_for_any_edge().await;
+        info!("COMP1 crossed, now {}", comp1.output_level());
+    }
+}
