// BBC micro:bit v2 (nRF52833) - a BOARD definition, like the Pico ones.
//
// bottom: the edge connector, left to right from the LED side. Rings 0/1/2,
//         3V and GND are the large pads; the small pads are numbered 3..22,
//         and 17/18 are tied to 3V, 21/22 to GND.
// top:    nets wired to on-board hardware and not brought to the connector.
//
// Pad names lead with the nRF port and pin (`P0.31`) so codegen can read the
// GPIO; the part in parentheses is the board's own name for the net.
//
// Pin map from the microbit-v2 0.16 BSP (`microbit-common/src/v2/gpio.rs`),
// cross-checked against tech.microbit.org (edge connector + schematic pages).
// UART directions follow the BSP, which names them from the nRF's side: the
// schematic names the same two nets from the interface MCU's side.
//
// No 32.768 kHz crystal is fitted: XL1/XL2 (P0.00/P0.01) are wired as the
// speaker and SPI MISO. LFCLK is therefore the internal RC or synthesized
// from HFCLK, and the clock graph offers exactly those two.
//
// SPI uses SPIM2 and I2C uses TWIM0/TWIM1. SPIM0/SPIM1 share their peripheral
// IDs with TWIM0/TWIM1, so offering them here would let two modules claim one
// block. SPIM2 has no hardware chip select; NSS is a GPIO.
//
// Pads 8/9 (P0.10/P0.09) default to NFC on the nRF52833. embassy-nrf exposes
// them only with `nfc-pins-as-gpio`; nrf52833-hal needs UICR NFCPINS written.
//
// Pad 12 is reserved: tech.microbit.org says the accessibility pin should not
// be used for anything else.
McuDefinition(
    id: "nrf52833_microbit_v2",
    display_name: "BBC micro:bit v2",
    family: "nrf52833",
    package: "edge connector",
    board_chip: Some("nRF52833"),
    max_mhz: Some(64),
    sram_kb: Some(128),
    cpu: "ARM Cortex-M4F",
    toolchain: RustEmbedded,
    project: ProjectDef(
        pkg_name: "nrf52833_microbit_v2",
        target: "thumbv7em-none-eabihf",
        flash_origin: "0x00000000",
        flash_size: "512K",
        ram_origin: "0x20000000",
        ram_size: "128K",
        hal_dep: "nrf52833-hal = { version = \"0.19\", default-features = false, features = [\"rt\"] }",
        hal_dep_async: Some("embassy-nrf = { version = \"0.11\", features = [\"nrf52833\", \"time-driver-rtc1\", \"gpiote\", \"nfc-pins-as-gpio\"] }"),
        probe_chip: "nRF52833_xxAA",
        memory_comment: "BBC micro:bit v2 (nRF52833)  -  512 KiB Flash / 128 KiB RAM",
    ),
    pins: PinLayout(
        top: [
            PinDef(
                number: 26,
                name: "P0.21 (ROW1)",
                reserved: false,
                functions: [
                    GpioOutput,
                    TimerPwm(
                        timer: 0,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 0,
                        channel: 2,
                    ),
