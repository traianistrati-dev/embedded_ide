                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 1,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 0,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 1,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 2,
                    ),
                    TimerPwm(
                        timer: 2,
                        channel: 3,
                    ),
                    TimerPwm(
                        timer: 3,
                        channel: 0,
                    ),
