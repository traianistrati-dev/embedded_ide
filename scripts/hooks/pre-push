#!/bin/sh
# Cross-compile the generated projects before anything leaves this machine.
#
# Enable once, per clone:
#
#     git config core.hooksPath scripts/hooks
#
# `core.hooksPath` rather than copying into .git/hooks so the hook is versioned
# with the code it guards — a hook that lives only in one working copy protects
# only one working copy.
#
# Skip a single push with `git push --no-verify` when you know the codegen is
# untouched and you do not want to wait for the embassy builds.

set -e

if [ "$EIDE_SKIP_CODEGEN_CHECK" = "1" ]; then
    echo "pre-push: codegen matrix skipped (EIDE_SKIP_CODEGEN_CHECK=1)"
    exit 0
fi

# Only when something that FEEDS the generators changed. A README edit should
# not cost ten minutes of cross-compiling, and a hook that always costs that
# much is a hook people disable.
#
# What is being pushed comes from STDIN — git feeds a pre-push hook one
# `<local ref> <local sha> <remote ref> <remote sha>` line per ref. That is the
# only authoritative answer. Comparing against a branch name instead looks
# equivalent and is not: this repo has no `origin/HEAD`, so the obvious
# `origin/HEAD..HEAD` degrades to `git diff HEAD`, which diffs the WORKING TREE
# — it would fire on uncommitted edits that are not being pushed, and skip
# silently when you commit the codegen and push with a clean tree, which is the
# one case that matters.
# Paths that feed the generators. `assets/mcus/` belongs here: a chip
# definition IS codegen input — a `.ron` with a bad pin table generates a
# project that does not compile, and until this line said so a push carrying
# only chip definitions skipped the matrix entirely.
RELEVANT='^(src/panels/mcu_module/|scripts/verify-codegen|assets/mcus/)'

changed=""
saw_ref=0
verify_sha=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Strip any trailing CR. Git writes these lines itself and uses LF, but a
    # hook is also run by hand and by other tooling, and a stray `\r` turns the
    # range into `<sha>\r..<sha>` — a rev git rejects, which under `set -e`
    # killed this script silently. A pre-push hook that dies ABORTS THE PUSH, so
    # a cosmetic input problem became a blocked push with no explanation.
    local_sha=$(printf '%s' "$local_sha" | tr -d '\r')
    remote_sha=$(printf '%s' "$remote_sha" | tr -d '\r')
    [ -z "$local_sha" ] && continue
    saw_ref=1
    if [ -z "$verify_sha" ]; then verify_sha="$local_sha"; fi
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # deleting a ref
    case "$remote_sha" in
        *[!0]*) range="$remote_sha..$local_sha" ;;
        *)      range="" ;;                               # new branch: unknown
    esac
    if [ -z "$range" ]; then
        changed="unknown"
        break
    fi
    # `|| range unusable` rather than letting `set -e` end it: this filter is an
    # OPTIMISATION. When it cannot answer, the honest outcome is to run the
    # matrix, never to block the push over a range we failed to read.
    if ! diff_out=$(git diff --name-only "$range" 2>/dev/null); then
        changed="unknown"
        break
    fi
    changed="$changed$diff_out
"
done

# Run outside a push (manual invocation, or a shell that gave us no stdin) and
# for a brand-new branch: no reliable range, so do the safe thing rather than
# the cheap one.
if [ "$saw_ref" = "0" ]; then
    # No refs at all. Two very different reasons, and one message for both used
    # to cost thirteen minutes for nothing.
    #
    # Git ALWAYS gives the hook a pipe, even when it has nothing to send — so an
    # empty pipe means the push is a no-op and there is nothing to verify.
    # Running the matrix there is waste, not caution. A tty on stdin means a
    # person ran this by hand, and then checking everything IS the useful answer.
    if [ -t 0 ]; then
        echo "pre-push: run by hand with no refs - running the matrix over the working tree"
    else
        echo "pre-push: git sent no refs - nothing is being pushed, matrix skipped"
        exit 0
    fi
elif [ "$changed" = "unknown" ]; then
    echo "pre-push: could not read the push range - running the matrix to be safe"
elif ! printf '%s' "$changed" | grep -qE "$RELEVANT"; then
    echo "pre-push: no codegen changes in what is being pushed - matrix skipped"
    exit 0
fi

# Which families this push can possibly break.
#
# The whole set costs about twenty minutes, and a gate that costs twenty minutes
# is a gate people turn off — this repo already has the scar (`--no-verify`, and
# two pushes abandoned partway on 2026-08-27). So when the change is provably
# confined to one backend, run that backend's representative case instead.
#
# Narrowing is only safe when EVERY relevant path maps to a family. Anything
# shared (`family.rs` holds four backends, `project_gen.rs` builds every
# project), anything unrecognised, and any `.ron` chip definition drops back to
# the full quick set. The default is the expensive, correct one.
fams=""
narrow=1
if [ "$changed" = "unknown" ]; then
    narrow=0
else
    for f in $(printf '%s' "$changed" | grep -E "$RELEVANT" | sort -u); do
        case "$f" in
            src/panels/mcu_module/codegen/rp.rs)
                fams="$fams rp" ;;
            src/panels/mcu_module/codegen/stm32.rs|src/panels/mcu_module/codegen/rtic.rs)
                fams="$fams f1" ;;
            src/panels/mcu_module/codegen/embassy_async.rs|            src/panels/mcu_module/codegen/embassy_common.rs|            src/panels/mcu_module/codegen/wba.rs|            src/panels/mcu_module/codegen/watchdog_gen.rs)
                fams="$fams embassy" ;;
            src/panels/mcu_module/codegen/rcc_n6.rs)
                fams="$fams n6" ;;
            src/panels/mcu_module/codegen_esp_configs.rs)
                fams="$fams esp" ;;
            *)
                narrow=0 ;;
        esac
    done
fi
hook_arg=""
if [ "$narrow" = "1" ] && [ -n "$fams" ]; then
    hook_arg=$(printf '%s' "$fams" | tr ' ' '
' | grep -v '^$' | sort -u | paste -sd, -)
fi

# If a matrix run is already going, ask before spending a quarter of an hour
# behind it.
#
# The script itself WAITS when it finds the lock held, which is right for it: it
# has no idea whether anyone is watching. A hook does — someone just typed
# `git push` — so it can offer the choice the script cannot.
#
# `/dev/tty`, not stdin: a pre-push hook's stdin is git's ref list, already read
# above, so `read` there returns EOF instantly. And `-t 30` because a prompt
# with no deadline would hang every non-interactive push forever, which is a far
# worse failure than the wait it is trying to save.
lock="${TMP:-${TEMP:-/tmp}}/eide-codegen-matrix.lock"
if [ -e "$lock" ] && ! (: >> "$lock") 2>/dev/null; then
    # `tr -d` strips a UTF-8 BOM: owner files written before the encoding was
    # fixed still have one, and it lands in the middle of the message.
    owner=$(cat "${lock%.lock}.owner" 2>/dev/null | tr -d '\357\273\277' || true)
    # Not `[ -r /dev/tty ]`: on Git Bash that test passes for a device that
    # cannot actually be opened, so every non-interactive push printed two
    # "No such device or address" lines before falling back. Try the open
    # instead, in a subshell, and let the failure be the answer.
    if (exec 3< /dev/tty) 2>/dev/null && (exec 3> /dev/tty) 2>/dev/null; then
        {
            echo "pre-push: a codegen matrix run is already going${owner:+ ($owner)}."
            printf 'pre-push: [w]ait for it, [s]kip the check, or [a]bort the push? [w] '
        } > /dev/tty
        answer=""
        read -t 30 -r answer < /dev/tty || answer=""
        case "$answer" in
            s|S) echo "pre-push: matrix skipped - you asked"; exit 0 ;;
            a|A) echo "pre-push: push aborted - you asked"; exit 1 ;;
            *)   echo "pre-push: waiting for the other run" ;;
        esac
    else
        echo "pre-push: a codegen matrix run is already going${owner:+ ($owner)} - waiting"
    fi
fi

# Verify WHAT IS BEING PUSHED, in a worktree of its own.
#
# Running the matrix over the working tree tests whatever happens to be on disk,
# which is NOT what the push carries: commit, edit, push, and the hook blesses
# the edit while the commits go out unchecked. A pre-push hook that tests
# something other than the push gives a guarantee it does not have.
#
# It also removes a whole class of accident. The matrix drives `cargo test` in
# the repo, so anyone editing a source file — or running cargo — during a run
# changes what it is compiling underneath it. That is not hypothetical: it cost
# a push. A detached worktree at the pushed sha cannot be edited by accident,
# because nobody is working in it.
#
# CARGO_TARGET_DIR is kept OUTSIDE the worktree and reused between pushes. A
# fresh worktree starts with an empty target/, and paying a full rebuild of the
# IDE on every push would make this hook the thing people disable.
worktree=""
repo_root=$(git rev-parse --show-toplevel)
cleanup_worktree() {
    if [ -n "$worktree" ]; then
        # Leave the worktree BEFORE removing it. Windows will not delete a
        # directory that is some process's working directory, and this trap runs
        # with the shell still inside it — so without this the worktree survives
        # every push and `git worktree list` fills up with corpses.
        cd "$repo_root" 2>/dev/null || cd /
        git -C "$repo_root" worktree remove --force "$worktree" >/dev/null 2>&1 || rm -rf "$worktree"
    fi
}
trap cleanup_worktree EXIT

if [ -n "$verify_sha" ]; then
    # ONE PATH PER RUN. It used to be a fixed name, and two pushes at once then
    # fought over the same directory: the second could not `rm -rf` a worktree
    # the first was still checking, `set -e` turned that into a dead hook, and
    # the push was refused with nothing to explain it.
    #
    # The lock further down serialises the MATRIX, but the worktree is made
    # before the script that takes it - so the path has to be private on its own.
    worktree="${TMP:-${TEMP:-/tmp}}/eide-push-check-$$"
    rm -rf "$worktree"
    # `rm -rf` deletes the DIRECTORY; git keeps its own registration under
    # .git/worktrees, and an orphaned one makes every later `add` fail with
    # "missing but already registered". A push interrupted after the worktree
    # was made leaves exactly that — and from then on this hook falls back to
    # the working tree silently, on every push, forever. Prune is safe: it only
    # drops entries whose directory is already gone.
    git worktree prune
    # Keep the error. Falling back silently is what made a real failure here
    # look like the feature simply not existing: the matrix ran, the push
    # passed, and nothing said the worktree had never been made.
    wt_err=$(git worktree add --detach "$worktree" "$verify_sha" 2>&1) && wt_ok=1 || wt_ok=0
    if [ "$wt_ok" = "1" ]; then
        echo "pre-push: checking ${verify_sha%${verify_sha#???????}} in its own worktree"
        # Follows EIDE_MATRIX_DIR when it is set, so this cache lands on the
        # same volume the matrix writes to. It grew to 11.8 GB on its own,
        # and leaving it on a full C: while the projects moved elsewhere
        # would just relocate half the problem.
        # Same three places the matrix script reads, same order, so the cache
        # and the projects cannot end up on different volumes.
        matrix_dir="$EIDE_MATRIX_DIR"
        if [ -z "$matrix_dir" ] && [ -f "$repo_root/scripts/matrix-dir.txt" ]; then
            matrix_dir=$(tr -d '
' < "$repo_root/scripts/matrix-dir.txt")
        fi
        CARGO_TARGET_DIR="${matrix_dir:-${TMP:-${TEMP:-/tmp}}}/eide-hook-target"
        export CARGO_TARGET_DIR
        cd "$worktree"
    else
        # Honest degradation: a worktree we cannot make is a reason to check the
        # working tree, never a reason to block the push.
        echo "pre-push: could not add a worktree for $verify_sha - checking the working tree"
        echo "pre-push:   git said: $(printf '%s' "$wt_err" | head -2 | tr '
' ' ')"
        echo "pre-push:   (path tried: $worktree)"
        worktree=""
    fi
fi

# Ask the script that will actually RUN whether it knows the flag.
#
# This hook comes from the working tree (`core.hooksPath` points there), but the
# script comes from the worktree at the pushed sha — two revisions of one pair.
# Push a commit from before `-Hook` existed and the flag reaches a script that
# refuses it; a pre-push hook that errors ABORTS THE PUSH, so a speed
# optimisation would have become a wall you cannot push through.
#
# Degrade to the full set, the same way a worktree we cannot create degrades to
# the working tree: slower is a nuisance, blocked is a regression.
if [ -n "$hook_arg" ] && ! grep -q 'string\[\]\]\$Hook' scripts/verify-codegen.ps1 2>/dev/null; then
    echo "pre-push: this revision's verify-codegen.ps1 predates -Hook - running the full set"
    hook_arg=""
fi

echo "pre-push: cross-compiling the generated projects…"
if [ -n "$hook_arg" ]; then
    echo "pre-push: only $hook_arg touched - one representative case each"
    echo "pre-push: run scripts/verify-codegen.ps1 by hand for the whole matrix"
else
    echo "pre-push: 24 cases, about 21 minutes on a warm tree - it prints a per-case time"
fi
echo "pre-push: skip with 'git push --no-verify', or EIDE_SKIP_CODEGEN_CHECK=1"
if command -v pwsh >/dev/null 2>&1; then
    ps_exe="pwsh"; set -- -NoProfile -File scripts/verify-codegen.ps1
else
    ps_exe="powershell"; set -- -NoProfile -ExecutionPolicy Bypass -File scripts/verify-codegen.ps1
fi
if [ -n "$hook_arg" ]; then
    "$ps_exe" "$@" -Hook "$hook_arg"
else
    "$ps_exe" "$@"
fi
